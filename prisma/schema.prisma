generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Pet {
  id        String   @id @default(uuid())
  name      String
  type      String   
  age       String
  imageUrl  String?  
  createdAt DateTime @default(now())
}